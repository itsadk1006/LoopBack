# MongoDB connection (leave empty or unset to use local JSON file fallback)
MONGODB_URI=
MONGODB_DATABASE=loopback_db

# App Settings
PORT=8000
HOST=0.0.0.0
ENV=development

# LLM Provider Configuration ("ollama" or "bedrock")
LLM_PROVIDER=ollama

# AWS Bedrock Settings (required if LLM_PROVIDER=bedrock)
AWS_PROFILE=default
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=meta.llama3-8b-instruct-v1:0
# NOTE: DO NOT PUT REAL AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY HERE
# Use AWS CLI profiles or standard environment variables outside of Git
