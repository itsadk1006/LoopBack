# MongoDB connection (leave empty or unset to use local JSON file fallback)
MONGODB_URI=
MONGODB_DATABASE=loopback_db

# App Settings
PORT=8000
HOST=0.0.0.0
ENV=development

# LLM Provider Configuration ("ollama", "strands", or "bedrock")
# Default is "ollama". Set LLM_PROVIDER=strands to explicitly enable the AWS Strands Agents SDK provider.
LLM_PROVIDER=ollama

# Local Ollama Settings (used by direct "ollama" provider)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=llama3.2:latest

# AWS Strands Agents SDK Settings (used if LLM_PROVIDER=strands)
# Strands Agents SDK runs locally using the local Ollama runtime. Default verified model is gemma:2b (prompt-based reasoning without tool calling).
STRANDS_MODEL_ID=gemma:2b

# AWS Bedrock Settings (required if LLM_PROVIDER=bedrock)
AWS_PROFILE=default
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=meta.llama3-8b-instruct-v1:0
# NOTE: DO NOT PUT REAL AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY HERE
# Use AWS CLI profiles or standard environment variables outside of Git
